{
  "name": "@deep-focus/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Deep Focus desktop app — Electron shell that hosts the answer panel.",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "cross-env ELECTRON_RUN_AS_NODE= vite",
    "build": "tsc --noEmit && cross-env ELECTRON_RUN_AS_NODE= vite build && electron-builder --dir",
    "build:pack": "tsc --noEmit && cross-env ELECTRON_RUN_AS_NODE= vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "framer-motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "highlight.js": "^11.10.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
