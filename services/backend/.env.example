# Which provider handles text chat / vision / image generation.
#   auto    pick the first provider with an API key
#   xai     force Grok
#   openai  force OpenAI
#   mock    canned responses (useful before any keys are wired up)
# Defaults:
#   CHAT_PROVIDER=auto    → xAI → OpenAI → mock
#   VISION_PROVIDER=auto  → OpenAI → xAI → mock
#   IMAGE_PROVIDER=auto   → OpenAI → xAI → mock
CHAT_PROVIDER=auto
VISION_PROVIDER=auto
IMAGE_PROVIDER=auto

# xAI Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-reasoning
XAI_VISION_MODEL=grok-2-vision-latest
XAI_IMAGE_MODEL=grok-2-image

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

# Optional: where to persist sessions. If unset, sessions live in memory
# and are lost when the backend restarts. Phase 4: point this at a writable
# directory (e.g. $HOME/.deep-focus/sessions.sqlite) to persist.
# SESSION_DB_PATH=
